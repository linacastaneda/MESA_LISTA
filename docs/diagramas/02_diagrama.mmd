classDiagram
  direction TB
  class Usuario {
    +int id
    +str nombre
    +str correo
    +Rol rol
    +bool activo
  }
  class Restaurante {
    +int id
    +str nombre
    +str ciudad
    +bool activo
  }
  class AsignacionAdministrador {
    +int usuario_id
    +int restaurante_id
  }
  class Mesa {
    +int id
    +int restaurante_id
    +str numero
    +int capacidad
    +bool activa
  }
  class HorarioAtencion {
    +int id
    +int restaurante_id
    +int dia_semana
    +time apertura
    +time cierre
  }
  class Reserva {
    +int id
    +int cliente_id
    +int creado_por_id
    +int mesa_id
    -DatosReserva _datos
    -EstadoReserva _estado
    +datetime fin
    +datetime fecha_creacion
    +str token_operacion
    +cancelar(ahora) bool
  }
  class DatosReserva {
    +int restaurante_id
    +datetime inicio
    +int personas
    +str observaciones
    +validar()
    +clonar() DatosReserva
  }
  Usuario "1" --> "0..*" AsignacionAdministrador
  Restaurante "1" --> "0..*" AsignacionAdministrador
  Restaurante "1" --> "0..*" Mesa
  Restaurante "1" --> "0..*" HorarioAtencion
  Usuario "1" --> "0..*" Reserva : cliente
  Usuario "1" --> "0..*" Reserva : creador
  Mesa "1" --> "0..*" Reserva
  Reserva "1" *-- "1" DatosReserva
